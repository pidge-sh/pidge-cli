#!/usr/bin/env bash
# Cut a release: tag origin/main as v<package.json version> and push the tag.
# Works from any checkout — the current branch and the working tree are never
# read, the target is always what is on the remote main. The tag is what starts
# .github/workflows/publish.yml — nothing else does, and no workflow creates
# tags. Run it after the PR that
# bumped the version has merged; the human gate is the staged-publish approval on npmjs.com.
set -euo pipefail
cd "$(dirname "$0")/.."

git fetch -q origin main --tags

version=$(git show origin/main:package.json | node -p "JSON.parse(require('fs').readFileSync(0, 'utf8')).version")
tag="v$version"
if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
  echo "release-tag: $tag already exists — bump the version in package.json first" >&2; exit 1
fi
if [ -n "$(git ls-remote --tags origin "refs/tags/$tag")" ]; then
  echo "release-tag: $tag already exists on origin" >&2; exit 1
fi
if npm view "pidge-cli@$version" version >/dev/null 2>&1; then
  echo "release-tag: pidge-cli@$version is already on the registry" >&2; exit 1
fi

echo "release-tag: tagging origin/main ($(git rev-parse --short origin/main)) as $tag"
git tag -a "$tag" -m "$version" origin/main
git push origin "$tag"

cat <<MSG

$tag pushed. The publish workflow is running:
  https://github.com/pidge-sh/pidge-cli/actions/workflows/publish.yml

Next:
  1. If the npm-publish Environment still requires a reviewer, approve the run there.
  2. Approve pidge-cli@$version under "Staged Packages" on npmjs.com — this is the gate that matters.
  3. Verify:  npm view pidge-cli@$version dist.attestations
MSG
