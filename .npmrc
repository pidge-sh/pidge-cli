# Dependency cooldown: refuse to install any package version published less than
# 3 days ago. Compromised releases are usually caught and unpublished within
# hours, so a short delay filters most of them at the install layer without any
# scanning or monitoring.
#
# Requires npm >= 11.10.0 (where `min-release-age` landed; the value is in days).
# This repo's `engines` floor is node >= 18, whose bundled npm is older than
# that — those versions ignore the key and install normally. That is the intended
# degradation: the cooldown is a hardening measure for whoever has a new enough
# npm, not a build requirement.
#
# It applies to `npm install` / `npm ci` in this tree only. It does not affect
# consumers of the published package (npm never publishes .npmrc), and it has no
# effect on `npm publish`.
min-release-age=3

# No lifecycle scripts from dependencies, ever. This tree has zero runtime
# dependencies and one devDependency, none of which need an install hook, so a
# script appearing in one is a signal, not a feature. CI passes --ignore-scripts
# explicitly too, so a missing/edited .npmrc cannot quietly re-enable them.
ignore-scripts=true
